        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"A1\",\n  \"correo\": \"correo-malo\",\n  \"contrasena\": \"123\",\n  \"edad\": 200,\n  \"telefono\": \"12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }

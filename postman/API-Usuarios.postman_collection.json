  "item": [
    {
      "name": "01 - Bienvenida",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registrar usuario (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "description": "Registra un usuario y guarda su id en la variable {{id}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Torres\",\n  \"correo\": \"ana.torres@correo.com\",\n  \"contrasena\": \"Segura2026\",\n  \"edad\": 21,\n  \"telefono\": \"0991234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test(\"Devuelve el usuario creado sin contraseña\", () => {",
              "  pm.expect(json.data).to.have.property(\"id\");",
              "  pm.expect(json.data).to.not.have.property(\"contrasena\");",
              "});",
              "pm.collectionVariables.set(\"id\", json.data.id);"
            ]
          }
        }
      ]
    },
    {

              "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Lista los errores por campo\", () => pm.expect(pm.response.json().errores.length).to.eql(5));"
            ]
          }
        }
      ]
    },
